# The backend does NOT require these to start — SoLink sends your keys
# with each publish request from Settings in the app instead, so keys
# aren't sitting in a file on the server.
#
# This file is only here in case you'd rather hardcode a single set of
# keys server-side (e.g. for a single-user deployment). If you do that,
# edit server.js to read from process.env instead of req.body.keys.

PORT=8787

# X (Twitter) — developer.twitter.com, app must have Read+Write access
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# YouTube — Google Cloud Console, OAuth2 client with youtube.upload scope
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# Instagram — developers.facebook.com, Graph API, Instagram Business account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
